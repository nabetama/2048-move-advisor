{
  "manifest_version": 3,
  "name": "2048 Move Advisor",
  "version": "0.2.0",
  "description": "Reads the play2048.co board and recommends the next move, prioritizing the 2048 tile.",
  "content_scripts": [
    {
      "matches": [
        "https://play2048.co/*",
        "https://www.play2048.co/*"
      ],
      "js": ["solver.js", "auto-mode.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["solver.js", "worker.js"],
      "matches": [
        "https://play2048.co/*",
        "https://www.play2048.co/*"
      ]
    }
  ]
}
